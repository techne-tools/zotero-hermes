{
  "name": "zotero-hermes",
  "type": "module",
  "version": "0.1.0",
  "description": "Hermes AI Agent integration for Zotero — Chat with your research library",
  "config": {
    "addonName": "Hermes Agent for Zotero",
    "addonID": "hermes@nousresearch.com",
    "addonRef": "hermes",
    "addonInstance": "HermesAgent",
    "prefsPrefix": "extensions.zotero.hermes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NousResearch/zotero-hermes.git"
  },
  "author": "NousResearch",
  "bugs": {
    "url": "https://github.com/NousResearch/zotero-hermes/issues"
  },
  "homepage": "https://github.com/NousResearch/zotero-hermes#readme",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "serve": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
